{
  "name": "@chrome-stats/app-pass-sdk",
  "version": "2.0.3",
  "description": "SDK for App Pass integration",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "repository": {
    "type": "git",
    "url": "https://github.com/chrome-stats/app-pass-sdk.git"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts --clean",
    "deploy": "npm publish",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "chrome-stats",
    "app-pass",
    "sdk",
    "chrome-extension"
  ],
  "author": "Chrome Stats",
  "license": "MIT",
  "devDependencies": {
    "@types/chrome": "^0.0.260",
    "tsup": "^8.5.1"
  },
  "publishConfig": {
    "access": "public"
  }
}
